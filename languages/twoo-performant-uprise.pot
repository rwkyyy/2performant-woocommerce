#: twoo-performant-woo.php:103
msgid "Feed Product Filtering"
msgstr ""

#: twoo-performant-woo.php:105
msgid "Restrict which products appear in the feed. Leave this disabled (or every list empty) to include all published products. When enabled, a product is included if it matches ANY selected category, brand, or tag."
msgstr ""

#: twoo-performant-woo.php:109
msgid "Enable feed filtering"
msgstr ""

#: twoo-performant-woo.php:111
msgid "When unchecked, the feed includes every published product (default behaviour)."
msgstr ""

#: twoo-performant-woo.php:116
msgid "Include categories"
msgstr ""

#: twoo-performant-woo.php:121
msgid "Products in any selected category (and its sub-categories) are included."
msgstr ""

#: twoo-performant-woo.php:126
msgid "Include brands"
msgstr ""

#: twoo-performant-woo.php:131
msgid "Products assigned to any selected brand are included."
msgstr ""

#: twoo-performant-woo.php:136
msgid "Include tags"
msgstr ""

#: twoo-performant-woo.php:141
msgid "Products with any selected tag are included."
msgstr ""

#: twoo-performant-woo.php:151
msgid "VAT Override"
msgstr ""

#: twoo-performant-woo.php:153
msgid "Only used when WooCommerce taxes are disabled. If your store runs without WooCommerce tax settings, prices still include VAT that WooCommerce cannot strip. Set your VAT rate here and it will be removed from the net sale values reported to 2Performant (iframe + Big Bear). Leave at 0 to disable. Automatically ignored whenever WooCommerce taxes are enabled."
msgstr ""

#: twoo-performant-woo.php:157
msgid "VAT rate (%)"
msgstr ""

#: twoo-performant-woo.php:159
msgid "For example 19 for 19%. Set to 0 to disable."
msgstr ""
